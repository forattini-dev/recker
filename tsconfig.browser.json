{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/browser",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": [
    "src/browser/**/*",
    "src/core/**/*",
    "src/types/**/*",
    "src/transport/fetch.ts",
    "src/transport/worker.ts",
    "src/plugins/retry.ts",
    "src/plugins/rate-limit.ts",
    "src/plugins/dedup.ts",
    "src/plugins/circuit-breaker.ts",
    "src/plugins/graphql.ts",
    "src/plugins/soap.ts",
    "src/plugins/xml.ts",
    "src/plugins/jsonrpc.ts",
    "src/plugins/odata.ts",
    "src/plugins/grpc-web.ts",
    "src/plugins/logger.ts",
    "src/plugins/server-timing.ts",
    "src/plugins/cookie-jar.ts",
    "src/plugins/xsrf.ts",
    "src/plugins/auth.ts",
    "src/plugins/auth/**/*",
    "src/plugins/har-recorder.ts",
    "src/plugins/har-player.ts",
    "src/plugins/network-simulation.ts",
    "src/plugins/cache.ts",
    "src/plugins/compression.ts",
    "src/plugins/pagination.ts",
    "src/plugins/proxy-rotator.ts",
    "src/plugins/user-agent.ts",
    "src/plugins/scrape.ts",
    "src/plugins/csv.ts",
    "src/plugins/yaml.ts",
    "src/plugins/hls.ts",
    "src/cache/**/*",
    "src/cookies/**/*",
    "src/utils/**/*",
    "src/constants/**/*",
    "src/seo/**/*",
    "src/scrape/**/*",
    "src/ai/**/*",
    "src/presets/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "benchmark",
    "examples",
    "docs",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
